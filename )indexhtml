<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Segoe UI',sans-serif;
}

body{
background:#0f172a;
color:white;
overflow-x:hidden;
}

/* HEADER */

header{
background:linear-gradient(135deg,#7c3aed,#0ea5e9);
padding:25px;
text-align:center;
box-shadow:0 4px 10px rgba(0,0,0,.3);
}

/* LOGO */

.logo{
width:140px;
height:140px;
object-fit:cover;
border-radius:30px;
margin-bottom:15px;
box-shadow:0 0 30px rgba(168,85,247,.8);
border:3px solid rgba(255,255,255,.2);
animation:float 3s ease-in-out infinite;
}

@keyframes float{
0%{
transform:translateY(0px);
}
50%{
transform:translateY(-10px);
}
100%{
transform:translateY(0px);
}
}

header h1{
font-size:32px;
margin-bottom:8px;
}

header p{
opacity:.9;
}

nav{
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:10px;
padding:15px;
background:#111827;
position:sticky;
top:0;
z-index:100;
}

nav button{
padding:10px 18px;
border:none;
border-radius:12px;
background:#1e293b;
color:white;
cursor:pointer;
transition:.3s;
font-weight:bold;
}

nav button:hover{
background:#7c3aed;
transform:scale(1.05);
}

section{
display:none;
padding:25px;
max-width:900px;
margin:auto;
animation:fade .5s;
}

section.active{
display:block;
}

@keyframes fade{
from{
opacity:0;
transform:translateY(10px);
}
to{
opacity:1;
transform:translateY(0);
}
}

.card{
background:#1e293b;
padding:20px;
border-radius:20px;
margin-bottom:20px;
box-shadow:0 5px 15px rgba(0,0,0,.3);
}

.card h2{
margin-bottom:15px;
color:#c084fc;
}

input{
width:100%;
padding:12px;
margin-top:10px;
margin-bottom:15px;
border:none;
border-radius:10px;
background:#0f172a;
color:white;
}

.action-btn{
width:100%;
padding:12px;
border:none;
border-radius:12px;
background:linear-gradient(135deg,#7c3aed,#0ea5e9);
color:white;
font-size:16px;
font-weight:bold;
cursor:pointer;
transition:.3s;
}

.action-btn:hover{
transform:scale(1.03);
}

.result{
margin-top:20px;
padding:15px;
border-radius:15px;
background:#0f172a;
line-height:1.7;
}

.article{
margin-bottom:15px;
padding:15px;
background:#0f172a;
border-radius:15px;
}

.share-btn{
display:inline-block;
padding:12px 20px;
background:#22c55e;
border-radius:12px;
color:white;
text-decoration:none;
font-weight:bold;
margin-top:10px;
}

.dana{
text-align:center;
padding:20px;
background:#1e293b;
border-radius:20px;
margin-top:20px;
}

.dana-number{
font-size:24px;
font-weight:bold;
margin:15px 0;
color:#facc15;
}

.copy-btn{
padding:10px 18px;
border:none;
border-radius:12px;
background:#f59e0b;
color:black;
font-weight:bold;
cursor:pointer;
}

footer{
margin-top:40px;
padding:25px;
text-align:center;
background:#111827;
font-size:14px;
color:#94a3b8;
}

.hero{
text-align:center;
padding:40px 20px;
}

.hero h2{
font-size:36px;
margin-bottom:15px;
color:#c084fc;
}

.hero p{
font-size:18px;
opacity:.9;
}

</style>
</head>

<body>

<!-- HEADER -->
<header>

<img
src="a_logo_for_astro_primbon_digital_is_displayed_ag.png"
