<!-- SCRIPT -->
<script>

function showPage(id){

document.querySelectorAll("section")
.forEach(sec=>{
sec.classList.remove("active");
});

document.getElementById(id)
.classList.add("active");

}

function getZodiak(day,month){

if((month==1 && day>=20)||(month==2 && day<=18))
return "Aquarius";

if((month==2 && day>=19)||(month==3 && day<=20))
return "Pisces";

if((month==3 && day>=21)||(month==4 && day<=19))
return "Aries";

if((month==4 && day>=20)||(month==5 && day<=20))
return "Taurus";

if((month==5 && day>=21)||(month==6 && day<=20))
return "Gemini";

if((month==6 && day>=21)||(month==7 && day<=22))
return "Cancer";

if((month==7 && day>=23)||(month==8 && day<=22))
return "Leo";

if((month==8 && day>=23)||(month==9 && day<=22))
return "Virgo";

if((month==9 && day>=23)||(month==10 && day<=22))
return "Libra";

if((month==10 && day>=23)||(month==11 && day<=21))
return "Scorpio";

if((month==11 && day>=22)||(month==12 && day<=21))
return "Sagitarius";

return "Capricorn";

}

function cekZodiak(){

let tgl=
document.getElementById("tglLahir").value;

if(!tgl){
alert("Masukkan tanggal lahir");
return;
}

let date=new Date(tgl);

let d=date.getDate();
let m=date.getMonth()+1;

let z=getZodiak(d,m);

document.getElementById("hasilZodiak")
.innerHTML=
`
<h3>✨ Zodiak Kamu: ${z}</h3>

<p><b>Karir:</b>
Peluang besar datang dari ide kreatifmu.
</p>

<p><b>Asmara:</b>
Hubungan akan semakin harmonis.
</p>

<p><b>Keuangan:</b>
Ada peluang rezeki baru.
</p>
`;

}

function cekRasi(){

let tgl=
document.getElementById("tglRasi").value;

if(!tgl){
alert("Masukkan tanggal lahir");
return;
}

let date=new Date(tgl);

let d=date.getDate();
let m=date.getMonth()+1;

let z=getZodiak(d,m);

document.getElementById("hasilRasi")
.innerHTML=
`
<h3>🌌 ${z}</h3>

<p>
Rasi ini melambangkan energi,
keberanian dan intuisi tinggi.
</p>
`;

}

function cekPrimbon(){

let nama=
document.getElementById("nama").value;

let tgl=
document.getElementById("tglPrimbon").value;

if(nama=="" || tgl==""){
alert("Lengkapi data");
return;
}

let warna=[
"Merah","Biru","Hijau","Ungu","Emas"
];

let unsur=[
"Api","Air","Tanah","Udara"
];

let angka=
Math.floor(Math.random()*99)+1;

let warnaHoki=
warna[Math.floor(Math.random()*warna.length)];

let unsurAlam=
unsur[Math.floor(Math.random()*unsur.length)];

document.getElementById("hasilPrimbon")
.innerHTML=
`
<h3>🧿 Hasil Primbon ${nama}</h3>

<p><b>Weton:</b> Legi</p>

<p><b>Unsur Alam:</b>
${unsurAlam}
</p>

<p><b>Angka Keberuntungan:</b>
${angka}
</p>

<p><b>Warna Keberuntungan:</b>
${warnaHoki}
</p>

<p>
<b>Sifat:</b>
Memiliki aura positif dan mudah menarik rezeki.
</p>
`;

}

function copyDana(){

let dana=
document.getElementById("danaNumber").innerText;

navigator.clipboard.writeText(dana);

alert("Nomor DANA berhasil disalin");

}

function shareWeb(){

if(navigator.share){

navigator.share({
title:"Astro Primbon Digital",
text:"Cek ramalan astrologi di sini!",
url:window.location.href
});

}else{

alert("Browser tidak mendukung share");

}

}

/* PWA */

if ("serviceWorker" in navigator) {

window.addEventListener("load", ()=>{

navigator.serviceWorker.register("sw.js");

});

}

</script>

</body>
