<!-- ARTIKEL -->
<section id="artikel">

<div class="card">

<h2>📖 Artikel Astrologi</h2>

<div class="article">
<h3>🌙 Pengaruh Bulan</h3>
<p>
Fase bulan dipercaya mempengaruhi
emosi dan energi spiritual manusia.
</p>
</div>

